enum PaymentMethod {
  CASH
  AIRTEL_MONEY
  TNM_MPAMBA
  NATIONAL_BANK
  STANDARD_BANK
  FDH_BANK
  NBS_BANK
  OTHER_BANK
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SubmittedBy {
  BURSAR
  PARENT
}

//  FEE STRUCTURE 
model FeeStructure {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  academicYear String
  term         Term
  totalAmount  Decimal @db.Decimal(12, 2)
  currency     String  @default("MWK")

  tuitionFee           Decimal? @db.Decimal(12, 2)
  examFee              Decimal? @db.Decimal(12, 2)
  buildingLevy         Decimal? @db.Decimal(12, 2)
  uniformFee           Decimal? @db.Decimal(12, 2)
  bookFee              Decimal? @db.Decimal(12, 2)
  otherFees            Decimal? @db.Decimal(12, 2)
  otherFeesDescription String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, academicYear, term])
  @@map("fee_structures")
}

//  FEE PAYMENT 
model FeePayment {
  id        String  @id @default(uuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  platformFee   Decimal?      @db.Decimal(12, 2)
  netAmount     Decimal?      @db.Decimal(12, 2)
  currency      String        @default("MWK")
  paymentMethod PaymentMethod
  term          Term
  academicYear  String

  receiptNumber String  @unique
  receiptImage  String?
  notes         String?

  submittedBy SubmittedBy
  status      PaymentStatus @default(PENDING)

  parentPhone   String?
  bankReference String?

  recordedById    String?
  recordedBy      Staff?    @relation("RecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  verifiedById    String?
  verifiedBy      Staff?    @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason String?

  requiredAmount      Decimal? @db.Decimal(12, 2)
  balance             Decimal? @db.Decimal(12, 2)
  isDebtor            Boolean  @default(false)
  creditApplied       Decimal  @default(0) @db.Decimal(12, 2)
  overpayment         Decimal  @default(0) @db.Decimal(12, 2)
  malipoTransactionId String?
  malipoStatus        String?
  malipoCustomerRef   String?
  malipoFailureReason String?
  malipoRawResponse   Json?
  paymentChannel      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications NotificationLog[]

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@index([term, academicYear])
  @@map("fee_payments")
}

//  NOTIFICATION LOG 
model NotificationLog {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  channel       String
  phone         String?
  email         String?
  recipientName String?

  message  String
  subject  String?
  type     String
  template String?

  status       String
  messageId    String?
  cost         String?
  errorMessage String?

  paymentId String?
  payment   FeePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  sentById  String?
  sentBy    Staff?      @relation(fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([channel])
  @@index([type])
  @@index([createdAt])
  @@map("sms_logs")
}

//  SUBSCRIPTION PAYMENT 
model SubscriptionPayment {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("MWK")
  term         Term
  academicYear String

  method String // "ONEKHUSA" | "MANUAL"

  onekhusaTransactionRef String? @unique
  onekhusaTimedAccount   String?
  onekhusaStatus         String?
  onekhusaRawResponse    Json?

  status PaymentStatus @default(PENDING)
  paidAt DateTime?

  markedById String?
  markedBy   PlatformAdmin? @relation(fields: [markedById], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([status])
  @@index([term, academicYear])
  @@map("subscription_payments")
}

//  STUDENT DISCOUNTS 
// Allows schools to apply bursaries, scholarships, staff waivers, etc.
model StudentDiscount {
  id        String  @id @default(uuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  term         Term
  academicYear String
  amount       Decimal @db.Decimal(12, 2)
  reason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure a student only gets one discount per term
  @@unique([studentId, term, academicYear])
  @@map("student_discounts")
}
