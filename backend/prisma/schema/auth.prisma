enum Term {
  TERM_1
  TERM_2
  TERM_3
}

enum PlatformRole {
  OWNER
  SUPPORT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  READONLY
  LOCKED
  SUSPENDED
}

//  PLATFORM 
model Platform {
  id    String @id @default(uuid())
  name  String @default("SchoolPay Malawi")
  email String
  phone String

  //  Subscription Defaults (per new school) 
  defaultTermPrice                  Float   @default(0)
  defaultTrialDays                  Int     @default(30)
  currency                          String  @default("MWK")
  tiers                             Json?
  subscriptionMerchantAccount       String?
  subscriptionWebhookSecretSuccess  String?
  subscriptionWebhookSecretReversed String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools       School[]
  admins        PlatformAdmin[]
  notifications Notification[]

  @@map("platform")
}

//  SCHOOL
model School {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])

  name         String
  slug         String? @unique
  address      String
  city         String
  phone        String
  email        String?
  logo         String?
  motto        String?
  primaryColor String  @default("#1e3a8a")

  isActive Boolean @default(true)

  bankAccounts        Json?
  airtelMoneyNumber   String?
  airtelMoneyName     String?
  mpambaNumber        String?
  mpambaName          String?
  paymentInstructions String?

  activeTerm                    Term?
  activeAcademicYear            String?
  activeTermStartDate           DateTime?
  activeTermEndDate             DateTime?
  notificationDefaults          Json?
  onekhusaMerchantAccount       String?            @unique
  onekhusaWebhookSecretSuccess  String?
  onekhusaWebhookSecretReversed String?
  settlementBankName            String?
  settlementAccountName         String?
  settlementAccountNumber       String?
  settlementBranch              String?
  subscriptionStatus            SubscriptionStatus @default(TRIAL)
  trialEndsAt                   DateTime?
  subscriptionEndsAt            DateTime?
  setupCompleted                Boolean            @default(false)

  //  Legacy subscription fields (keep, do not use) 
  subscriptionPaid Boolean   @default(false)
  subscriptionDate DateTime?
  nextPaymentDate  DateTime?

  tier        String   @default("SMALL")
  maxStudents Int      @default(150)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  staff                Staff[]
  departments          Department[]
  roles                Role[]
  classes              Class[]
  students             Student[]
  payments             FeePayment[]
  notificationLogs     NotificationLog[]
  feeStructures        FeeStructure[]
  examPeriods          ExamPeriod[]
  subjects             Subject[]
  gradeBoundaries      GradeBoundary[]
  examResults          ExamResult[]
  pendingExamRows      PendingExamRow[]
  termActivations      TermActivation[]
  subscriptionPayments SubscriptionPayment[]
  notifications        Notification[]
  studentDiscounts     StudentDiscount[]
  employees            Employee[]
  payrollRecords       PayrollRecord[]
  supportTickets       SupportTicket[]

  @@map("schools")
}

//  DEPARTMENT 
model Department {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff[]
  employees Employee[]

  @@unique([schoolId, name])
  @@map("departments")
}

model Role {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  description String?
  permissions Json
  isSystem    Boolean @default(false) // protects default roles from deletion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("roles")
}

//  STAFF 
model Staff {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  title     String?
  firstName String
  lastName  String
  fullName  String

  email        String  @unique
  phone        String
  passwordHash String?
  avatar       String?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  emailVerified            Boolean   @default(false)
  emailVerificationOtp     String?
  emailVerificationExpires DateTime?

  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  invitedById       String?
  invitedBy         Staff?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited           Staff[]   @relation("InvitedBy")
  invitedAt         DateTime?
  invitationToken   String?   @unique
  invitationExpires DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  refreshTokenHash     String?
  refreshTokenExpires  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentsRecorded  FeePayment[]      @relation("RecordedBy")
  paymentsVerified  FeePayment[]      @relation("VerifiedBy")
  notificationsSent NotificationLog[]

  @@index([schoolId])
  @@index([email])
  @@map("staff")
}

//  PARENT OTP 
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

//  AUDIT LOG 
// Every action taken by a staff member. Actor snapshot is denormalized
// so the log survives staff deletion or role changes.
model AuditLog {
  id       String  @id @default(uuid())
  schoolId String?
  staffId  String?

  // Actor snapshot (denormalized at write time)
  actorName  String?
  actorRole  String?
  actorEmail String?

  // What happened
  action     String
  entity     String
  entityId   String?
  targetName String?
  changes    Json?

  // Result
  status String @default("SUCCESS")

  // Request metadata
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([staffId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformAdmin {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  fullName String
  email    String       @unique
  phone    String
  role     PlatformRole @default(OWNER)

  passwordHash String?
  avatar       String?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  // Email verification
  emailVerified            Boolean   @default(false)
  emailVerificationOtp     String?
  emailVerificationExpires DateTime?

  // Password
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // Invitations (owner invites support staff)
  invitedById       String?
  invitedBy         PlatformAdmin?  @relation("PlatformInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited           PlatformAdmin[] @relation("PlatformInvitedBy")
  invitedAt         DateTime?
  invitationToken   String?         @unique
  invitationExpires DateTime?

  // Password reset
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // Login lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Refresh token (session)
  refreshTokenHash    String?
  refreshTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markedSubscriptionPayments SubscriptionPayment[]
  resolvedNotifications      Notification[]        @relation("ResolvedNotifications")

  @@index([email])
  @@map("platform_admins")
}

enum NotificationStatus {
  UNREAD
  READ
  RESOLVED
}

//  NOTIFICATION 

model Notification {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // What kind of event
  type    String
  title   String
  message String
  payload Json?

  status NotificationStatus @default(UNREAD)

  // Who triggered it (denormalized snapshot)
  actorStaffId String?
  actorName    String?

  // Resolution
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   PlatformAdmin? @relation("ResolvedNotifications", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId, status])
  @@index([schoolId])
  @@map("notifications")
}

//  SCHOOL REQUESTS 
model SchoolRequest {
  id         String @id @default(uuid())
  name       String
  email      String
  phone      String
  schoolName String
  tier       String
  status     String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_requests")
}

// ==================== EMPLOYEE & PAYROLL ====================

model Employee {
  id           String      @id @default(uuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Identity
  firstName   String
  lastName    String
  fullName    String
  title       String? // Driver, Cook, Teacher, etc.
  phone       String?
  email       String?
  nationalId  String?
  dateOfBirth DateTime?
  hireDate    DateTime?
  photo       String?

  // Salary — additions
  basicSalary        Decimal @default(0) @db.Decimal(12, 2)
  housingAllowance   Decimal @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal @default(0) @db.Decimal(12, 2)
  otherAllowances    Decimal @default(0) @db.Decimal(12, 2)

  // Salary — deductions
  payeTax          Decimal @default(0) @db.Decimal(12, 2)
  pensionDeduction Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal @default(0) @db.Decimal(12, 2)

  // Status
  status          String    @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  terminationDate DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRecords PayrollRecord[]

  @@index([schoolId, status])
  @@index([schoolId, departmentId])
  @@map("employees")
}

model PayrollRecord {
  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month String // "2026-10"
  year  Int

  // Snapshot of salary at generation time
  basicSalary        Decimal @db.Decimal(12, 2)
  housingAllowance   Decimal @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal @default(0) @db.Decimal(12, 2)
  otherAllowances    Decimal @default(0) @db.Decimal(12, 2)

  payeTax          Decimal @default(0) @db.Decimal(12, 2)
  pensionDeduction Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal @default(0) @db.Decimal(12, 2)

  // One-time additions for this month
  bonus                Decimal @default(0) @db.Decimal(12, 2)
  bonusReason          String?
  extraDeduction       Decimal @default(0) @db.Decimal(12, 2)
  extraDeductionReason String?

  // Computed
  grossSalary     Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netSalary       Decimal @db.Decimal(12, 2)

  status String    @default("PENDING") // PENDING | PAID
  paidAt DateTime?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([schoolId, month, status])
  @@map("payroll_records")
}

// ==================== SUPPORT TICKETS ====================

model SupportTicket {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Routing
  ticketType String // "SCHOOL_SUPPORT" | "PLATFORM_SUPPORT"

  // Creator
  creatorType  String // "PARENT" | "STAFF"
  creatorId    String
  creatorName  String
  creatorEmail String? // required for STAFF tickets (email replies)
  creatorPhone String? // required for PARENT tickets (SMS replies)

  subject String
  status  String @default("OPEN") // OPEN | RESOLVED | CLOSED

  // Last reply tracking (for unread badges)
  lastReplyAt DateTime?
  lastReplyBy String? // "CREATOR" | "RESPONDER"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([schoolId, ticketType, status])
  @@index([schoolId, ticketType, lastReplyAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderType String
  senderName String
  message    String @db.Text

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_messages")
}
