enum Term {
  TERM_1
  TERM_2
  TERM_3
}

enum PlatformRole {
  OWNER
  SUPPORT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  READONLY
  LOCKED
  SUSPENDED
}

//  PLATFORM 
model Platform {
  id    String @id @default(uuid())
  name  String @default("SchoolPay Malawi")
  email String
  phone String

  // ============ Subscription Defaults (per new school) ============
  defaultTermPrice Float  @default(0)
  defaultTrialDays Int    @default(30)
  currency         String @default("MWK")

  // ============ Your own OneKhusa merchant (subscription revenue) ============
  // This is where SCHOOLS' subscription payments land — not parents' fees.
  subscriptionMerchantAccount       String?
  subscriptionWebhookSecretSuccess  String?
  subscriptionWebhookSecretReversed String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools       School[]
  admins        PlatformAdmin[]
  notifications Notification[]

  @@map("platform")
}

//  SCHOOL
model School {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])

  name         String
  slug         String? @unique
  address      String
  city         String
  phone        String
  email        String?
  logo         String?
  motto        String?
  primaryColor String  @default("#1e3a8a")

  isActive Boolean @default(true)

  bankAccounts        Json?
  airtelMoneyNumber   String?
  mpambaNumber        String?
  paymentInstructions String?

  activeTerm           Term?
  activeAcademicYear   String?
  activeTermStartDate  DateTime?
  activeTermEndDate    DateTime?
  notificationDefaults Json?

  // ============ OneKhusa (per-school merchant) ============
  onekhusaMerchantAccount       String? @unique
  onekhusaWebhookSecretSuccess  String?
  onekhusaWebhookSecretReversed String?

  // ============ Settlement Account (online payments) ============
  // Separate from `bankAccounts` — that one is for manual receipt upload.
  // This is where ONLINE payments land (used by owner when creating
  // the school's merchant account in OneKhusa).
  settlementBankName      String?
  settlementAccountName   String?
  settlementAccountNumber String?
  settlementBranch        String?

  //  Subscription (billing by owner) 
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  setupCompleted     Boolean            @default(false)

  //  Legacy subscription fields (keep, do not use) 
  subscriptionPaid Boolean   @default(false)
  subscriptionDate DateTime?
  nextPaymentDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    // Relations
  staff                Staff[]
  departments          Department[]
  roles                Role[]
  classes              Class[]
  students             Student[]
  payments             FeePayment[]
  notificationLogs     NotificationLog[]
  feeStructures        FeeStructure[]
  examPeriods          ExamPeriod[]
  subjects             Subject[]
  gradeBoundaries      GradeBoundary[]
  examResults          ExamResult[]
  pendingExamRows      PendingExamRow[]
  termActivations      TermActivation[]
  subscriptionPayments SubscriptionPayment[]
  notifications        Notification[]
  studentDiscounts     StudentDiscount[] 

  @@map("schools")
}

//  DEPARTMENT 
model Department {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]

  @@unique([schoolId, name])
  @@map("departments")
}

//  ROLE 
// Custom roles created by admin in Settings.
// permissions shape: { "students": ["read","write"], "payments": ["read","verify"] }
model Role {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  description String?
  permissions Json
  isSystem    Boolean @default(false) // protects default roles from deletion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("roles")
}

//  STAFF 
model Staff {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  title     String?
  firstName String
  lastName  String
  fullName  String

  email        String  @unique
  phone        String
  passwordHash String?
  avatar       String?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  emailVerified            Boolean   @default(false)
  emailVerificationOtp     String?
  emailVerificationExpires DateTime?

  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  invitedById       String?
  invitedBy         Staff?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited           Staff[]   @relation("InvitedBy")
  invitedAt         DateTime?
  invitationToken   String?   @unique
  invitationExpires DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  refreshTokenHash     String?
  refreshTokenExpires  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentsRecorded  FeePayment[]      @relation("RecordedBy")
  paymentsVerified  FeePayment[]      @relation("VerifiedBy")
  notificationsSent NotificationLog[]

  @@index([schoolId])
  @@index([email])
  @@map("staff")
}

//  PARENT OTP 
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

//  AUDIT LOG 
// Every action taken by a staff member. Actor snapshot is denormalized
// so the log survives staff deletion or role changes.
model AuditLog {
  id       String  @id @default(uuid())
  schoolId String?
  staffId  String?

  // Actor snapshot (denormalized at write time)
  actorName  String?
  actorRole  String?
  actorEmail String?

  // What happened
  action     String // e.g. "STUDENT_ADDED", "LOGIN_SUCCESS", "PAYMENT_VERIFIED"
  entity     String // "Student", "Payment", "Staff", "Session", ...
  entityId   String?
  targetName String? // human-readable target, e.g. student's full name
  changes    Json? // { before: {...}, after: {...} } OR full payload

  // Result
  status String @default("SUCCESS") // "SUCCESS" | "FAILED"

  // Request metadata
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([staffId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformAdmin {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  fullName String
  email    String       @unique
  phone    String
  role     PlatformRole @default(OWNER)

  passwordHash String?
  avatar       String?

  isActive  Boolean   @default(true)
  lastLogin DateTime?

  // Email verification
  emailVerified            Boolean   @default(false)
  emailVerificationOtp     String?
  emailVerificationExpires DateTime?

  // Password
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // Invitations (owner invites support staff)
  invitedById       String?
  invitedBy         PlatformAdmin?  @relation("PlatformInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited           PlatformAdmin[] @relation("PlatformInvitedBy")
  invitedAt         DateTime?
  invitationToken   String?         @unique
  invitationExpires DateTime?

  // Password reset
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // Login lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Refresh token (session)
  refreshTokenHash    String?
  refreshTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markedSubscriptionPayments SubscriptionPayment[]
  resolvedNotifications      Notification[]        @relation("ResolvedNotifications")

  @@index([email])
  @@map("platform_admins")
}

enum NotificationStatus {
  UNREAD
  READ
  RESOLVED
}

//  NOTIFICATION 
// In-app notifications for the platform owner (you).
// e.g. a school requests a settlement account change.
model Notification {
  id         String   @id @default(uuid())
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  // Optional link to a school (for school-originated events)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // What kind of event
  type    String // "SETTLEMENT_CHANGE_REQUEST"
  title   String
  message String
  payload Json? // event-specific data

  status NotificationStatus @default(UNREAD)

  // Who triggered it (denormalized snapshot)
  actorStaffId String?
  actorName    String?

  // Resolution
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   PlatformAdmin? @relation("ResolvedNotifications", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId, status])
  @@index([schoolId])
  @@map("notifications")
}
