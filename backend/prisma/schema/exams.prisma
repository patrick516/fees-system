enum ExamType {
  MID_TERM
  END_TERM
  MOCK
}

model ExamPeriod {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name         String
  term         Term
  academicYear String
  examType     ExamType @default(END_TERM)
  isActive     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examResults     ExamResult[]
  pendingExamRows PendingExamRow[]

  @@unique([schoolId, term, academicYear, examType])
  @@map("exam_periods")
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  name     String
  code     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examResults ExamResult[]

  @@unique([schoolId, classId, name])
  @@map("subjects")
}

model GradeBoundary {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  system     GradingSystem @default(POINTS)
  minPercent Float
  maxPercent Float
  gradePoint Int?
  gradeLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grade_boundaries")
}

model ExamResult {
  id           String     @id @default(uuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examPeriodId String
  examPeriod   ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)

  mark       Float
  gradePoint Int?
  gradeLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, examPeriodId])
  @@index([schoolId])
  @@index([examPeriodId])
  @@map("exam_results")
}

model PendingExamRow {
  id           String     @id @default(uuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId      String
  class        Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  examPeriodId String
  examPeriod   ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)

  rawName             String
  marks               Json
  candidateStudentIds String[]

  resolvedStudentId String?
  resolvedAt        DateTime?

  createdAt DateTime @default(now())

  @@map("pending_exam_rows")
}